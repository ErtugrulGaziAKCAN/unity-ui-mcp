/* M0 spike twin of f05-absolute-in-flex.html. Element names equal the HTML ids. */
/* UI Toolkit defaults match the HTML base rules: flex-direction column, position relative, flex-shrink 1. */
/* The panel must run with NO theme stylesheet, or with these resets winning: the HTML applies
   `* { margin: 0; padding: 0 }` and a root text colour, so the twin must not pick up theme label margins/padding. */
* {
  margin: 0;
  padding: 0;
}
Label,
.unity-label {
  margin: 0;
  padding: 0;
}
#root {
  width: 100%;
  height: 100%;
  background-color: #0b1f26;
}
#root {
  padding: 40px;
}
#f05-host {
  flex-direction: row;
  width: 800px;
  height: 300px;
  background-color: #14303a;
  justify-content: center;
  align-items: center;
}
#f05-flow {
  width: 200px;
  height: 100px;
  background-color: #1f8a70;
}
#f05-abs-br {
  width: 100px;
  height: 50px;
  background-color: #2c6fbb;
  position: absolute;
  right: 20px;
  bottom: 20px;
}
#f05-abs-tl {
  width: 100px;
  height: 50px;
  background-color: #c0572b;
  position: absolute;
  left: 10px;
  top: 10px;
}
#f05-abs-noinset {
  width: 100px;
  height: 50px;
  background-color: #8e44ad;
  position: absolute;
}
#f05-abs-stretch {
  width: auto;
  height: 40px;
  background-color: #d4a017;
  position: absolute;
  left: 300px;
  right: 300px;
  top: 200px;
}
#f05-abs-pct {
  width: 10%;
  height: 20%;
  background-color: #00a5b8;
  position: absolute;
  left: 60%;
  top: 5%;
}
#f05-host2 {
  width: 500px;
  height: 300px;
  margin-top: 40px;
  background-color: #14303a;
  padding: 30px;
}
#f05-flow2 {
  width: 200px;
  height: 100px;
  background-color: #1f8a70;
}
#f05-abs-pad {
  width: 100px;
  height: 50px;
  background-color: #2c6fbb;
  position: absolute;
  left: 0px;
  top: 0px;
}
