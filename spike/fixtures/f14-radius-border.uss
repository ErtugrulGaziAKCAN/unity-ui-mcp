/* M0 spike twin of f14-radius-border.html. Element names equal the HTML ids. */
/* UI Toolkit defaults match the HTML base rules: flex-direction column, position relative, flex-shrink 1. */
/* CSS in the HTML fixture that UI Toolkit cannot express:
   - #f14-circle border-radius: 50% -- percent radius, verify in Unity
   - #f14-dashed border-style: dashed -- USS borders are always solid
*/
#root {
  width: 100%;
  height: 100%;
  background-color: #0b1f26;
}
#root {
  padding: 40px;
}
#f14-grid {
  flex-direction: row;
  flex-wrap: wrap;
}
#f14-uniform {
  width: 300px;
  height: 180px;
  margin: 20px;
  background-color: #1b4a56;
  border-radius: 24px;
  border-width: 4px;
  border-color: #00e5ff;
}
#f14-sides {
  width: 300px;
  height: 180px;
  margin: 20px;
  background-color: #1b4a56;
  border-top-width: 2px;
  border-right-width: 6px;
  border-bottom-width: 10px;
  border-left-width: 14px;
  border-top-color: #ff0000;
  border-right-color: #00ff00;
  border-bottom-color: #0000ff;
  border-left-color: #ffff00;
}
#f14-corners {
  width: 300px;
  height: 180px;
  margin: 20px;
  background-color: #1b4a56;
  border-top-left-radius: 60px;
  border-top-right-radius: 10px;
  border-bottom-right-radius: 30px;
  border-bottom-left-radius: 0px;
  border-width: 3px;
  border-color: #ffffff;
}
/* UNSUPPORTED in UITK: border-radius: 50% -- percent radius, verify in Unity */
#f14-circle {
  width: 200px;
  height: 200px;
  margin: 20px;
  background-color: #1b4a56;
  border-radius: 50%;
  border-width: 6px;
  border-color: #d4a017;
}
#f14-pill {
  width: 300px;
  height: 80px;
  margin: 20px;
  background-color: #1b4a56;
  border-radius: 9999px;
  border-width: 2px;
  border-color: #8e44ad;
}
#f14-radius-noborder {
  width: 300px;
  height: 180px;
  margin: 20px;
  background-color: #1b4a56;
  border-radius: 40px;
}
/* UNSUPPORTED in UITK: border-style: dashed -- USS borders are always solid */
#f14-dashed {
  width: 300px;
  height: 180px;
  margin: 20px;
  background-color: #1b4a56;
  border-width: 4px;
  border-color: #00e5ff;
}
#f14-clip {
  width: 300px;
  height: 180px;
  margin: 20px;
  background-color: #1b4a56;
  border-radius: 40px;
  overflow: hidden;
}
#f14-clip-child {
  width: 200px;
  height: 120px;
  background-color: #c0572b;
  margin-left: -20px;
  margin-top: -20px;
}
