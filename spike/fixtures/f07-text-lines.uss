/* M0 spike twin of f07-text-lines.html. Element names equal the HTML ids. */
/* UI Toolkit defaults match the HTML base rules: flex-direction column, position relative, flex-shrink 1. */
/* CSS in the HTML fixture that UI Toolkit cannot express:
   - #f07-n-14-1 line-height: normal -- USS has no line-height (R2)
   - #f07-n-14-2 line-height: normal -- USS has no line-height (R2)
   - #f07-n-14-3 line-height: normal -- USS has no line-height (R2)
   - #f07-n-16-1 line-height: normal -- USS has no line-height (R2)
   - #f07-n-16-2 line-height: normal -- USS has no line-height (R2)
   - #f07-n-16-3 line-height: normal -- USS has no line-height (R2)
   - #f07-n-20-1 line-height: normal -- USS has no line-height (R2)
   - #f07-n-20-2 line-height: normal -- USS has no line-height (R2)
   - #f07-n-20-3 line-height: normal -- USS has no line-height (R2)
   - #f07-n-32-1 line-height: normal -- USS has no line-height (R2)
   - #f07-n-32-2 line-height: normal -- USS has no line-height (R2)
   - #f07-n-32-3 line-height: normal -- USS has no line-height (R2)
   - #f07-f-14-1 line-height: 20px -- USS has no line-height (R2)
   - #f07-f-14-2 line-height: 20px -- USS has no line-height (R2)
   - #f07-f-14-3 line-height: 20px -- USS has no line-height (R2)
   - #f07-f-16-1 line-height: 24px -- USS has no line-height (R2)
   - #f07-f-16-2 line-height: 24px -- USS has no line-height (R2)
   - #f07-f-16-3 line-height: 24px -- USS has no line-height (R2)
   - #f07-f-20-1 line-height: 28px -- USS has no line-height (R2)
   - #f07-f-20-2 line-height: 28px -- USS has no line-height (R2)
   - #f07-f-20-3 line-height: 28px -- USS has no line-height (R2)
   - #f07-f-32-1 line-height: 40px -- USS has no line-height (R2)
   - #f07-f-32-2 line-height: 40px -- USS has no line-height (R2)
   - #f07-f-32-3 line-height: 40px -- USS has no line-height (R2)
*/
/* The panel must run with NO theme stylesheet, or with these resets winning: the HTML applies
   `* { margin: 0; padding: 0 }` and a root text colour, so the twin must not pick up theme label margins/padding. */
* {
  margin: 0;
  padding: 0;
}
Label,
.unity-label {
  margin: 0;
  padding: 0;
}
#root {
  width: 100%;
  height: 100%;
  background-color: #0b1f26;
  color: #e8f1f2;
}
#root {
  padding: 40px;
}
#f07-grid {
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  align-items: flex-start;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
#f07-n-14-1 {
  font-size: 14px;
  white-space: normal;
  background-color: #14303a;
  margin: 10px;
  width: 300px;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
