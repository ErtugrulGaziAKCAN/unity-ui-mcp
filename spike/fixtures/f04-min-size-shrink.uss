/* M0 spike twin of f04-min-size-shrink.html. Element names equal the HTML ids. */
/* UI Toolkit defaults match the HTML base rules: flex-direction column, position relative, flex-shrink 1. */
/* CSS in the HTML fixture that UI Toolkit cannot express:
   - #f04-auto-text min-width: auto -- USS min-width auto is 0, not min-content
*/
#root {
  width: 100%;
  height: 100%;
  background-color: #0b1f26;
}
#root {
  padding: 40px;
}
#f04-row {
  flex-direction: row;
  width: 900px;
  height: 120px;
  background-color: #14303a;
}
#f04-m1 {
  width: 400px;
  height: 100px;
  background-color: #1f8a70;
  min-width: 350px;
}
#f04-m2 {
  width: 400px;
  height: 100px;
  background-color: #2c6fbb;
  min-width: 0px;
}
#f04-m3 {
  width: 400px;
  height: 100px;
  background-color: #c0572b;
}
#f04-m4 {
  width: 400px;
  height: 100px;
  background-color: #8e44ad;
  min-width: 0px;
  flex-shrink: 0;
  flex-basis: 100px;
}
#f04-row2 {
  flex-direction: row;
  width: 600px;
  height: 120px;
  margin-top: 40px;
  background-color: #14303a;
}
/* UNSUPPORTED in UITK: min-width: auto -- USS min-width auto is 0, not min-content */
#f04-auto-text {
  background-color: #d4a017;
  font-size: 28px;
  flex-shrink: 1;
}
#f04-fill {
  width: 500px;
  height: 100px;
  background-color: #00a5b8;
}
#f04-row3 {
  flex-direction: row;
  width: 500px;
  height: 120px;
  margin-top: 40px;
  background-color: #14303a;
}
#f04-h1 {
  width: 300px;
  height: 40px;
  background-color: #1f8a70;
  min-height: 80px;
}
#f04-h2 {
  width: 300px;
  height: 100px;
  background-color: #2c6fbb;
  max-width: 150px;
}
