<!-- M0 spike twin of f10-solid-colors-alpha.html: solid colors and alpha over dark background and bright stripe (R8). Font twin is wired in Task 3. -->
<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="f10-solid-colors-alpha.uss" />
  <ui:VisualElement name="root">
    <ui:VisualElement name="f10-opaque">
      <ui:VisualElement name="f10-o-red" />
      <ui:VisualElement name="f10-o-green" />
      <ui:VisualElement name="f10-o-blue" />
      <ui:VisualElement name="f10-o-white" />
      <ui:VisualElement name="f10-o-gray" />
      <ui:VisualElement name="f10-o-teal" />
      <ui:VisualElement name="f10-o-cyan" />
      <ui:VisualElement name="f10-o-dark" />
    </ui:VisualElement>
    <ui:VisualElement name="f10-alpha-w">
      <ui:VisualElement name="f10-w-10" />
      <ui:VisualElement name="f10-w-25" />
      <ui:VisualElement name="f10-w-50" />
      <ui:VisualElement name="f10-w-75" />
    </ui:VisualElement>
    <ui:VisualElement name="f10-alpha-c">
      <ui:VisualElement name="f10-c-10" />
      <ui:VisualElement name="f10-c-25" />
      <ui:VisualElement name="f10-c-50" />
      <ui:VisualElement name="f10-c-75" />
    </ui:VisualElement>
    <ui:VisualElement name="f10-nested">
      <ui:VisualElement name="f10-nest-parent">
        <ui:VisualElement name="f10-nest-child" />
      </ui:VisualElement>
      <ui:VisualElement name="f10-stripe">
        <ui:VisualElement name="f10-stripe-over" />
      </ui:VisualElement>
      <ui:VisualElement name="f10-opacity" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
