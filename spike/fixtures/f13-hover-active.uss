/* M0 spike twin of f13-hover-active.html. Element names equal the HTML ids. */
/* UI Toolkit defaults match the HTML base rules: flex-direction column, position relative, flex-shrink 1. */
#root {
  width: 100%;
  height: 100%;
  background-color: #0b1f26;
}
#root {
  padding: 40px;
}
#f13-btn {
  width: 320px;
  height: 96px;
  background-color: #1f8a70;
  border-width: 2px;
  border-color: #0b5c47;
  border-radius: 12px;
  align-items: center;
  justify-content: center;
}
#f13-btn:hover {
  background-color: #27ab8b;
  border-color: #7be0c4;
}
#f13-btn:active {
  background-color: #0f5f4c;
  border-color: #ffffff;
}
#f13-label {
  font-size: 32px;
  -unity-font-style: bold;
  color: #ffffff;
}
#f13-btn2 {
  width: 320px;
  height: 96px;
  margin-top: 40px;
  background-color: rgba(255,255,255,0.1);
  border-radius: 48px;
  align-items: center;
  justify-content: center;
}
#f13-btn2:hover {
  background-color: rgba(255,255,255,0.25);
}
#f13-btn2:active {
  background-color: rgba(255,255,255,0.4);
}
#f13-label2 {
  font-size: 24px;
}
