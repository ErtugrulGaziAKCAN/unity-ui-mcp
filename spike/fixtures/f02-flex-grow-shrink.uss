/* M0 spike twin of f02-flex-grow-shrink.html. Element names equal the HTML ids. */
/* UI Toolkit defaults match the HTML base rules: flex-direction column, position relative, flex-shrink 1. */
#root {
  width: 100%;
  height: 100%;
  background-color: #0b1f26;
}
#root {
  padding: 40px;
}
#f02-grow {
  flex-direction: row;
  width: 1200px;
  height: 100px;
  background-color: #14303a;
}
#f02-g1 {
  width: auto;
  height: 80px;
  background-color: #1f8a70;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 100px;
}
#f02-g2 {
  width: auto;
  height: 80px;
  background-color: #2c6fbb;
  flex-grow: 2;
  flex-shrink: 1;
  flex-basis: 100px;
}
#f02-g3 {
  width: 200px;
  height: 80px;
  background-color: #c0572b;
  flex-grow: 0;
  flex-shrink: 0;
}
#f02-g4 {
  width: auto;
  height: 80px;
  background-color: #8e44ad;
  flex-grow: 1;
  flex-shrink: 1;
  flex-basis: 0px;
}
#f02-shrink {
  flex-direction: row;
  width: 500px;
  height: 100px;
  margin-top: 40px;
  background-color: #14303a;
}
#f02-s1 {
  width: 300px;
  height: 80px;
  background-color: #1f8a70;
  flex-shrink: 1;
}
#f02-s2 {
  width: 400px;
  height: 80px;
  background-color: #2c6fbb;
  flex-shrink: 2;
}
#f02-s3 {
  width: 300px;
  height: 80px;
  background-color: #c0572b;
  flex-shrink: 0;
}
#f02-basis {
  flex-direction: row;
  width: 900px;
  height: 100px;
  margin-top: 40px;
  background-color: #14303a;
}
#f02-b1 {
  width: 100px;
  height: 80px;
  background-color: #1f8a70;
  flex-basis: 300px;
}
#f02-b2 {
  width: 500px;
  height: 80px;
  background-color: #2c6fbb;
  flex-basis: 200px;
  flex-grow: 1;
}
#f02-b3 {
  width: 100px;
  height: 80px;
  background-color: #c0572b;
  flex-basis: auto;
  flex-grow: 1;
}
#f02-col {
  width: 400px;
  height: 500px;
  margin-top: 40px;
  background-color: #14303a;
}
#f02-c1 {
  width: 200px;
  height: auto;
  background-color: #1f8a70;
  flex-grow: 1;
}
#f02-c2 {
  width: 200px;
  height: auto;
  background-color: #2c6fbb;
  flex-grow: 3;
}
#f02-c3 {
  width: 200px;
  height: 150px;
  background-color: #c0572b;
  flex-shrink: 0;
}
