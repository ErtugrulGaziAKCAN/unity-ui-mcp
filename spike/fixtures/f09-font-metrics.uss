/* M0 spike twin of f09-font-metrics.html. Element names equal the HTML ids. */
/* UI Toolkit defaults match the HTML base rules: flex-direction column, position relative, flex-shrink 1. */
/* CSS in the HTML fixture that UI Toolkit cannot express:
   - #f09-12 line-height: normal -- USS has no line-height (R2)
   - #f09-14 line-height: normal -- USS has no line-height (R2)
   - #f09-16 line-height: normal -- USS has no line-height (R2)
   - #f09-18 line-height: normal -- USS has no line-height (R2)
   - #f09-20 line-height: normal -- USS has no line-height (R2)
   - #f09-24 line-height: normal -- USS has no line-height (R2)
   - #f09-28 line-height: normal -- USS has no line-height (R2)
   - #f09-32 line-height: normal -- USS has no line-height (R2)
   - #f09-40 line-height: normal -- USS has no line-height (R2)
   - #f09-48 line-height: normal -- USS has no line-height (R2)
*/
/* The panel must run with NO theme stylesheet, or with these resets winning: the HTML applies
   `* { margin: 0; padding: 0 }` and a root text colour, so the twin must not pick up theme label margins/padding. */
* {
  margin: 0;
  padding: 0;
}
Label,
.unity-label {
  margin: 0;
  padding: 0;
}
#root {
  width: 100%;
  height: 100%;
  background-color: #0b1f26;
  color: #e8f1f2;
}
#root {
  padding: 40px;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
#f09-12 {
  font-size: 12px;
  background-color: #14303a;
  width: 400px;
  margin-bottom: 10px;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
#f09-14 {
  font-size: 14px;
  background-color: #14303a;
  width: 400px;
  margin-bottom: 10px;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
#f09-16 {
  font-size: 16px;
  background-color: #14303a;
  width: 400px;
  margin-bottom: 10px;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
#f09-18 {
  font-size: 18px;
  background-color: #14303a;
  width: 400px;
  margin-bottom: 10px;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
#f09-20 {
  font-size: 20px;
  background-color: #14303a;
  width: 400px;
  margin-bottom: 10px;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
#f09-24 {
  font-size: 24px;
  background-color: #14303a;
  width: 400px;
  margin-bottom: 10px;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
#f09-28 {
  font-size: 28px;
  background-color: #14303a;
  width: 400px;
  margin-bottom: 10px;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
#f09-32 {
  font-size: 32px;
  background-color: #14303a;
  width: 400px;
  margin-bottom: 10px;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
#f09-40 {
  font-size: 40px;
  background-color: #14303a;
  width: 400px;
  margin-bottom: 10px;
}
/* UNSUPPORTED in UITK: line-height: normal -- USS has no line-height (R2) */
#f09-48 {
  font-size: 48px;
  background-color: #14303a;
  width: 400px;
  margin-bottom: 10px;
}
#f09-row {
  flex-direction: row;
  align-items: baseline;
  margin-top: 20px;
}
#f09-bl-a {
  font-size: 16px;
  background-color: #14303a;
}
#f09-bl-b {
  font-size: 48px;
  background-color: #14303a;
  margin-left: 20px;
}
