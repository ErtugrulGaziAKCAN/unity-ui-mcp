/* M0 spike twin of f12-box-shadow.html. Element names equal the HTML ids. */
/* UI Toolkit defaults match the HTML base rules: flex-direction column, position relative, flex-shrink 1. */
/* CSS in the HTML fixture that UI Toolkit cannot express:
   - #f12-soft box-shadow: 0 8px 24px rgba(0,0,0,0.5) -- USS has no box-shadow; baked to 9-slice asset by the compiler
   - #f12-hard box-shadow: 10px 10px 0 rgba(0,0,0,0.6) -- USS has no box-shadow; baked to 9-slice asset by the compiler
   - #f12-glow box-shadow: 0 0 32px 4px rgba(0,229,255,0.6) -- USS has no box-shadow; baked to 9-slice asset by the compiler
   - #f12-radius box-shadow: 0 12px 40px 8px rgba(0,0,0,0.6) -- USS has no box-shadow; baked to 9-slice asset by the compiler
*/
#root {
  width: 100%;
  height: 100%;
  background-color: #0b1f26;
}
#root {
  padding: 40px;
}
#f12-grid {
  flex-direction: row;
  flex-wrap: wrap;
}
/* UNSUPPORTED in UITK: box-shadow: 0 8px 24px rgba(0,0,0,0.5) -- USS has no box-shadow; baked to 9-slice asset by the compiler */
#f12-soft {
  width: 300px;
  height: 180px;
  margin: 60px;
  background-color: #1b4a56;
}
/* UNSUPPORTED in UITK: box-shadow: 10px 10px 0 rgba(0,0,0,0.6) -- USS has no box-shadow; baked to 9-slice asset by the compiler */
#f12-hard {
  width: 300px;
  height: 180px;
  margin: 60px;
  background-color: #1b4a56;
}
/* UNSUPPORTED in UITK: box-shadow: 0 0 32px 4px rgba(0,229,255,0.6) -- USS has no box-shadow; baked to 9-slice asset by the compiler */
#f12-glow {
  width: 300px;
  height: 180px;
  margin: 60px;
  background-color: #1b4a56;
}
/* UNSUPPORTED in UITK: box-shadow: 0 12px 40px 8px rgba(0,0,0,0.6) -- USS has no box-shadow; baked to 9-slice asset by the compiler */
#f12-radius {
  width: 300px;
  height: 180px;
  margin: 60px;
  background-color: #1b4a56;
  border-radius: 32px;
}
