/* M0 spike twin of f03-percent-auto-parent.html. Element names equal the HTML ids. */
/* UI Toolkit defaults match the HTML base rules: flex-direction column, position relative, flex-shrink 1. */
#root {
  width: 100%;
  height: 100%;
  background-color: #0b1f26;
}
#root {
  padding: 40px;
}
#f03-wrap {
  flex-direction: row;
  align-items: flex-start;
}
#f03-p1 {
  background-color: #14303a;
  padding: 10px;
}
#f03-p1-fixed {
  width: 400px;
  height: 60px;
  background-color: #1f8a70;
}
#f03-p1-pct {
  width: 50%;
  height: 60px;
  background-color: #2c6fbb;
  margin-top: 10px;
}
#f03-p2 {
  background-color: #14303a;
  padding: 10px;
  margin-left: 40px;
  height: 300px;
}
#f03-p2-fixed {
  width: 300px;
  height: 100px;
  background-color: #c0572b;
}
#f03-p2-pcth {
  width: 150px;
  height: 50%;
  background-color: #8e44ad;
  margin-top: 10px;
}
#f03-p3 {
  background-color: #14303a;
  padding: 10px;
  margin-left: 40px;
  flex-direction: row;
}
#f03-p3-fixed {
  width: 200px;
  height: 80px;
  background-color: #d4a017;
}
#f03-p3-pct {
  width: 25%;
  height: 40px;
  background-color: #00a5b8;
}
#f03-p4 {
  width: 1000px;
  margin-top: 40px;
  background-color: #14303a;
  padding: 10px;
}
#f03-p4-a {
  width: 60%;
  height: 60px;
  background-color: #1f8a70;
}
#f03-p4-b {
  width: 30%;
  height: 60px;
  background-color: #2c6fbb;
  margin-top: 10px;
  margin-left: 5%;
}
