/* M0 spike twin of f06-wrap-margins.html. Element names equal the HTML ids. */
/* UI Toolkit defaults match the HTML base rules: flex-direction column, position relative, flex-shrink 1. */
/* The panel must run with NO theme stylesheet, or with these resets winning: the HTML applies
   `* { margin: 0; padding: 0 }` and a root text colour, so the twin must not pick up theme label margins/padding. */
* {
  margin: 0;
  padding: 0;
}
Label,
.unity-label {
  margin: 0;
  padding: 0;
}
#root {
  width: 100%;
  height: 100%;
  background-color: #0b1f26;
}
#root {
  padding: 40px;
}
#f06-wrap {
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  width: 1000px;
  background-color: #14303a;
}
#f06-i1 {
  width: 300px;
  height: 100px;
  background-color: #1f8a70;
  margin: 10px;
}
#f06-i2 {
  width: 300px;
  height: 100px;
  background-color: #2c6fbb;
  margin: 10px;
}
#f06-i3 {
  width: 300px;
  height: 100px;
  background-color: #c0572b;
  margin: 10px;
}
#f06-i4 {
  width: 300px;
  height: 100px;
  background-color: #8e44ad;
  margin: 10px;
}
#f06-i5 {
  width: 300px;
  height: 100px;
  background-color: #d4a017;
  margin: 10px;
}
#f06-i6 {
  width: 300px;
  height: 100px;
  background-color: #00a5b8;
  margin: 10px;
}
#f06-i7 {
  width: 300px;
  height: 100px;
  background-color: #1f8a70;
  margin: 10px;
}
#f06-i8 {
  width: 300px;
  height: 100px;
  background-color: #2c6fbb;
  margin: 10px;
}
#f06-wrap2 {
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  align-items: flex-start;
  width: 900px;
  height: 600px;
  margin-top: 40px;
  background-color: #14303a;
}
#f06-j1 {
  width: 200px;
  height: 80px;
  background-color: #1f8a70;
  margin: 15px 5px;
}
#f06-j2 {
  width: 220px;
  height: 100px;
  background-color: #2c6fbb;
  margin: 5px 15px;
}
#f06-j3 {
  width: 240px;
  height: 120px;
  background-color: #c0572b;
  margin: 15px 5px;
}
#f06-j4 {
  width: 260px;
  height: 80px;
  background-color: #8e44ad;
  margin: 5px 15px;
}
#f06-j5 {
  width: 280px;
  height: 100px;
  background-color: #d4a017;
  margin: 15px 5px;
}
#f06-j6 {
  width: 300px;
  height: 120px;
  background-color: #00a5b8;
  margin: 5px 15px;
}
