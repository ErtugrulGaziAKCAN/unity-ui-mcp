/* M0 spike twin of f01-row-fixed.html. Element names equal the HTML ids. */
/* UI Toolkit defaults match the HTML base rules: flex-direction column, position relative, flex-shrink 1. */
/* The panel must run with NO theme stylesheet, or with these resets winning: the HTML applies
   `* { margin: 0; padding: 0 }` and a root text colour, so the twin must not pick up theme label margins/padding. */
* {
  margin: 0;
  padding: 0;
}
Label,
.unity-label {
  margin: 0;
  padding: 0;
}
#root {
  width: 100%;
  height: 100%;
  background-color: #0b1f26;
}
#root {
  padding: 40px;
}
#f01-row-a {
  flex-direction: row;
  height: 200px;
  background-color: #14303a;
}
#f01-a1 {
  width: 300px;
  height: 100px;
  background-color: #1f8a70;
}
#f01-a2 {
  width: 400px;
  height: 100px;
  background-color: #2c6fbb;
  margin: 20px;
}
#f01-a3 {
  width: 500px;
  height: 150px;
  background-color: #c0572b;
}
#f01-row-b {
  flex-direction: row;
  height: 200px;
  margin-top: 40px;
  align-items: center;
  justify-content: space-between;
  background-color: #14303a;
}
#f01-b1 {
  width: 300px;
  height: 100px;
  background-color: #1f8a70;
}
#f01-b2 {
  width: 400px;
  height: 60px;
  background-color: #2c6fbb;
}
#f01-b3 {
  width: 500px;
  height: 150px;
  background-color: #c0572b;
}
#f01-row-c {
  flex-direction: row;
  height: 200px;
  margin-top: 40px;
  align-items: flex-end;
  justify-content: center;
  background-color: #14303a;
}
#f01-c1 {
  width: 300px;
  height: 100px;
  background-color: #1f8a70;
}
#f01-c2 {
  width: 400px;
  height: 60px;
  background-color: #2c6fbb;
}
#f01-row-d {
  flex-direction: row;
  margin-top: 40px;
  background-color: #14303a;
}
#f01-d1 {
  width: 300px;
  height: auto;
  background-color: #1f8a70;
  align-self: stretch;
  min-height: 50px;
}
#f01-d2 {
  width: 200px;
  height: 160px;
  background-color: #2c6fbb;
}
