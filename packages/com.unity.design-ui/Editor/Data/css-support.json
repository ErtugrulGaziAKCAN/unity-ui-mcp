{
  "version": 1,
  "units": [
    "px",
    "%"
  ],
  "colors": {
    "hex": true,
    "functions": [
      "rgb",
      "rgba"
    ],
    "keywords": [
      "transparent",
      "white",
      "black",
      "red",
      "green",
      "blue",
      "yellow",
      "cyan",
      "magenta",
      "gray",
      "grey",
      "orange",
      "purple",
      "pink",
      "brown",
      "silver",
      "gold",
      "navy",
      "teal",
      "lime",
      "maroon",
      "olive",
      "aqua",
      "fuchsia"
    ]
  },
  "notes": {
    "handling": "direct = written to USS (value validated); lowered = Lowering removes it, the mapper rejects leftovers; dropped = accepted and omitted; error = rejected with rule and fix. Properties not listed are U-CSS-023, value functions not listed are U-CSS-024.",
    "components": "[min,max] space-separated components per list item (default [1,1]); list = comma separated list allowed",
    "dropValues": "keyword values that are accepted and omitted",
    "mapValues": "keyword aliases rewritten before mapping"
  },
