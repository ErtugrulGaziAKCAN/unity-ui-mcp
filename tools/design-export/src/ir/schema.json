{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unity-ui-mcp/schemas/ir.schema.json",
  "title": "IrScreen",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "irVersion",
    "screen",
    "source",
    "referenceViewport",
    "viewports",
    "screenMatch",
    "states",
    "breakpoints",
    "tokens",
    "fonts",
    "root"
  ],
  "properties": {
    "irVersion": {
      "const": 1
    },
    "screen": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "A .dc.html Claude canvas artboard or a plain .html file."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "referenceViewport": {
      "$ref": "#/$defs/size"
    },
    "viewports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/size"
      },
      "minItems": 1
    },
    "screenMatch": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "breakpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "minWidth": {
            "type": "number"
          },
          "maxWidth": {
            "type": "number"
          },
          "minAspect": {
            "type": "number"
          },
          "maxAspect": {
            "type": "number"
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "locale",
          "family",
          "file",
          "sha256",
          "weight"
        ],
        "properties": {
          "locale": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      }
    },
    "root": {
      "$ref": "#/$defs/node"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "items": false,
      "minItems": 2
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      }
    },
    "styleMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "file",
        "sha256",
        "width",
        "height",
        "slice",
        "tint",
        "stopGap"
      ],
      "properties": {
        "kind": {
          "enum": [
            "image",
            "svg",
            "shadow9"
          ]
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "slice": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 4,
              "maxItems": 4
            }
          ],
          "description": "9-slice insets in image pixels, CSS box order: top, right, bottom, left."
        },
        "tint": {
          "type": "boolean",
          "description": "SVG painted with currentColor, written white: tinted with the node's color per layer."
        },
        "stopGap": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "minimum": 0
            }
          ],
          "description": "Baked gradient: smallest distance between consecutive colour stops of different colours, as a fraction of the gradient line (U-CSS-022); null for other assets."
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "external",
        "classes",
        "style",
        "text",
        "asset",
        "background",
        "shadow",
        "shadowLayers",
        "insetShadow",
        "insetShadowLayers",
        "backgroundLayers",
        "attrTexts",
        "initial",
        "bind",
        "action",
        "repeat",
        "anims",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "container",
            "text",
            "image",
            "vector",
            "button",
            "toggle",
            "input",
            "dropdown",
            "scroll",
            "list"
          ]
        },
        "external": {
          "type": "boolean"
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "style": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(base|(bp:[^+()]+|state:[^+()]+|class:[^+()]+|anc\\([^()+]+\\):(hover|active|focus|disabled|checked|class:[^+()]+)|hover|active|focus|disabled|checked)(\\+(bp:[^+()]+|state:[^+()]+|class:[^+()]+|anc\\([^()+]+\\):(hover|active|focus|disabled|checked|class:[^+()]+)|hover|active|focus|disabled|checked))*)$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/styleMap"
          }
        },
        "text": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/text"
            }
          ]
        },
        "asset": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/asset"
            }
          ]
        },
        "background": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/asset"
            }
          ],
          "description": "Base layer's background image: a url() image or the baked SVG of its gradients."
        },
        "backgroundLayers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(base|(bp:[^+()]+|state:[^+()]+|class:[^+()]+|anc\\([^()+]+\\):(hover|active|focus|disabled|checked|class:[^+()]+)|hover|active|focus|disabled|checked)(\\+(bp:[^+()]+|state:[^+()]+|class:[^+()]+|anc\\([^()+]+\\):(hover|active|focus|disabled|checked|class:[^+()]+)|hover|active|focus|disabled|checked))*)$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/asset"
              }
            ]
          },
          "description": "Layer key -> background image while exactly that layer holds, when it differs from the layers inside it; null: none."
        },
        "shadow": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/shadow"
            }
          ],
          "description": "Base layer's outer box-shadows baked into one 9-slice, drawn behind the element."
        },
        "shadowLayers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(base|(bp:[^+()]+|state:[^+()]+|class:[^+()]+|anc\\([^()+]+\\):(hover|active|focus|disabled|checked|class:[^+()]+)|hover|active|focus|disabled|checked)(\\+(bp:[^+()]+|state:[^+()]+|class:[^+()]+|anc\\([^()+]+\\):(hover|active|focus|disabled|checked|class:[^+()]+)|hover|active|focus|disabled|checked))*)$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/shadow"
              }
            ]
          },
          "description": "Layer key -> outer shadow while exactly that layer holds, when it differs; null: none."
        },
        "insetShadow": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/shadow"
            }
          ],
          "description": "Base layer's inset box-shadows baked into one 9-slice over the padding box, drawn above the background and below the content."
        },
        "insetShadowLayers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(base|(bp:[^+()]+|state:[^+()]+|class:[^+()]+|anc\\([^()+]+\\):(hover|active|focus|disabled|checked|class:[^+()]+)|hover|active|focus|disabled|checked)(\\+(bp:[^+()]+|state:[^+()]+|class:[^+()]+|anc\\([^()+]+\\):(hover|active|focus|disabled|checked|class:[^+()]+)|hover|active|focus|disabled|checked))*)$"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/shadow"
              }
            ]
          },
          "description": "Layer key -> inset shadow while exactly that layer holds, when it differs; null: none."
        },
        "bind": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        },
        "repeat": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "mode",
                "count"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "mode": {
                  "enum": [
                    "list",
                    "inline"
                  ]
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Items the design shows (the template included)."
                }
              }
            }
          ]
        },
        "anims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anim"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "attrTexts": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "placeholder",
              "title",
              "alt",
              "aria-label"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          }
        },
        "initial": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "disabled",
                "checked"
              ],
              "properties": {
                "disabled": {
                  "type": "boolean"
                },
                "checked": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "field": {
          "description": "Input nodes only: the text field's form. password: the value is masked; multiline: a text area; placeholderColor: the ::placeholder colour (null without a placeholder).",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "password",
            "multiline",
            "placeholderColor"
          ],
          "properties": {
            "password": {
              "type": "boolean"
            },
            "multiline": {
              "type": "boolean"
            },
            "placeholderColor": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "itemVisibility": {
          "description": "Repeat item elements only (absent elsewhere): the written-out items hide this element by their own markup (hidden attribute, inline display: none) in some items and show it in others. That hiding is sample data: style is the element shown, the item view gets a Set<Id>Visible(bool) setter and each sample item that hides it records $hidden.",
          "const": true
        }
      }
    },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "file",
        "sha256",
        "width",
        "height",
        "slice",
        "offset",
        "tint",
        "stopGap"
      ],
      "properties": {
        "kind": {
          "const": "shadow9"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "slice": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "9-slice insets in image pixels, CSS box order: top, right, bottom, left."
        },
        "offset": {
          "$ref": "#/$defs/rect",
          "description": "The image's rect relative to the element's border box (x, y, w, h): drawn at (x + offset.x, y + offset.y) with size (w + offset.w, h + offset.h), CSS px. Inset shadows: the padding box."
        },
        "tint": {
          "const": false
        },
        "stopGap": {
          "type": "null"
        }
      }
    },
    "anim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "trigger",
        "phase",
        "name",
        "properties",
        "duration",
        "delay",
        "timing",
        "iterations",
        "direction",
        "fillMode",
        "playState",
        "restart",
        "keyframes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "transition",
            "keyframes"
          ]
        },
        "trigger": {
          "type": "string",
          "pattern": "^(show|(bp:[^+()]+|state:[^+()]+|class:[^+()]+|anc\\([^()+]+\\):(hover|active|focus|disabled|checked|class:[^+()]+)|hover|active|focus|disabled|checked)(\\+(bp:[^+()]+|state:[^+()]+|class:[^+()]+|anc\\([^()+]+\\):(hover|active|focus|disabled|checked|class:[^+()]+)|hover|active|focus|disabled|checked))*)$",
          "description": "show, or the layer key whose start runs the animation"
        },
        "phase": {
          "enum": [
            "enter",
            "leave"
          ]
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "duration": {
          "type": "number",
          "minimum": 0,
          "description": "ms"
        },
        "delay": {
          "type": "number",
          "description": "ms, may be negative"
        },
        "timing": {
          "type": "string",
          "minLength": 1,
          "description": "CSS timing function as serialised by Chromium"
        },
        "iterations": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "const": "infinite"
            }
          ]
        },
        "direction": {
          "enum": [
            "normal",
            "reverse",
            "alternate",
            "alternate-reverse"
          ]
        },
        "fillMode": {
          "enum": [
            "none",
            "forwards",
            "backwards",
            "both"
          ]
        },
        "playState": {
          "enum": [
            "running",
            "paused"
          ]
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        },
        "restart": {
          "type": "boolean",
          "description": "keyframes: false when the layer only changes play state or timing of the running animation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "transition"
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "type": "null"
              },
              "iterations": {
                "type": "number",
                "const": 1
              },
              "direction": {
                "type": "string",
                "const": "normal"
              },
              "fillMode": {
                "type": "string",
                "const": "none"
              },
              "playState": {
                "type": "string",
                "const": "running"
              },
              "restart": {
                "type": "boolean",
                "const": true
              },
              "keyframes": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "type": "string",
                "const": "keyframes"
              }
            }
          },
          "then": {
            "properties": {
              "phase": {
                "type": "string",
                "const": "enter"
              }
            },
            "oneOf": [
              {
                "description": "an animation: its name and keyframes",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "keyframes": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              },
              {
                "description": "animation-name: none in the trigger layer: the element's animations (of these properties) stop while it holds",
                "properties": {
                  "name": {
                    "type": "null"
                  },
                  "keyframes": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "values",
        "easing"
      ],
      "properties": {
        "offset": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "values": {
          "$ref": "#/$defs/styleMap"
        },
        "easing": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "tr",
        "en",
        "args",
        "rich",
        "style"
      ],
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "tr": {
          "type": "string"
        },
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rich": {
          "type": "boolean"
        },
        "style": {
          "type": [
            "string",
            "null"
          ],
          "description": "Kit text style (text-styles.json name) the text matches, or null."
        }
      }
    }
  }
}
